# The deployed Deposit Back contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts) with scripted verdicts, no wallet and
# no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# Server only. A throwaway Studio test key that owns the six sample flats: POST /api/demo/report signs the
# landlord's move-out report with it, so one visitor can try the whole tenancy alone. Never a key that holds
# anything real. Unset: the site works and says the demo landlord is offline.
DEMO_LANDLORD_KEY=
